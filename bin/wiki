#!/usr/bin/env python3
"""watchtower wiki — fast search / inject / lint over a Karpathy-style markdown wiki.

This is the on-disk memory tool for the watchtower repo. It scans a corpus of
markdown "entity pages" (one concept per file) that are interlinked with
[[wikilinks]] and carry YAML-ish frontmatter.

Design goals:
  * Blazing fast: ripgrep does the keyword scan when available; otherwise a
    pure-python fallback keeps the tool working with zero external deps.
  * Lightweight index first, full content on demand: `search` returns a compact
    tree you can scan; `inject` dumps the full bodies (optionally following the
    link graph N hops out) for pulling into the chat context.
  * Self-validating: `lint` enforces the frontmatter contract so every page is
    discoverable.

No dependencies beyond the Python 3 stdlib. ripgrep (`rg`) is used if found.

Usage:
  wiki search <kw>... [--tag T]... [--type T] [--json] [--root DIR]
  wiki inject [<kw>...] [--page P]... [--depth N] [--all] [--max-bytes N] [--root DIR]
  wiki lint [--file F] [--root DIR]
  wiki links <page> [--root DIR]
  wiki tags [--root DIR]
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

REQUIRED_FRONTMATTER = ["title", "description", "tags", "type"]
# `type` is aligned to the top-level wiki domain directory (directory == domain).
VALID_TYPES = {"project", "infra", "stack", "security", "standard", "log", "reference", "meta", "roadmap", "todo", "growth"}
# `status` (optional) is the orthogonal volatility marker. living = dated/churny,
# excluded from normative reading; lives under wiki/logs/.
VALID_STATUS = {"normative", "reference", "living"}

# Top-level wiki domain directory -> the `type` its pages must carry.
DOMAIN_TYPE = {
    "projects": "project",
    "infra": "infra",
    "stack": "stack",
    "security": "security",
    "standards": "standard",
    "logs": "log",
    "reference": "reference",
    "meta": "meta",
    "roadmaps": "roadmap",
    "todos": "todo",
    "growth": "growth",
}

# `bin/wiki index` regenerates the navigation list of each _index.md hub between
# these markers (the hand-written preamble above the begin marker is preserved).
SHARDS_BEGIN = "<!-- shards:begin -->"
SHARDS_END = "<!-- shards:end -->"
SHARDS_NOTE = "<!-- generated by `bin/wiki index` — do not hand-edit between the markers -->"

FM_RE = re.compile(r"^---\s*\n(.*?)\n---\s*\n?", re.DOTALL)
WIKILINK_RE = re.compile(r"\[\[\s*([^\]|#]+?)\s*(?:#[^\]|]*)?(?:\|[^\]]*)?\]\]")
MDLINK_RE = re.compile(r"\[[^\]]*\]\(\s*(<[^>]+>|[^)\s]+)")

_READ_CACHE: dict[str, str] = {}


# --------------------------------------------------------------------------- #
# Corpus helpers
# --------------------------------------------------------------------------- #
def find_root(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).expanduser().resolve()
    env = os.environ.get("WATCHTOWER_WIKI")
    if env:
        return Path(env).expanduser().resolve()
    # default: <repo>/wiki, where this script lives at <repo>/bin/wiki
    return (Path(__file__).resolve().parent.parent / "wiki").resolve()


def read(path) -> str:
    key = str(path)
    if key not in _READ_CACHE:
        _READ_CACHE[key] = Path(path).read_text(encoding="utf-8", errors="replace")
    return _READ_CACHE[key]


def all_md_files(root: Path) -> list[Path]:
    return sorted(p for p in root.rglob("*.md") if p.is_file())


def slugify(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")


# --------------------------------------------------------------------------- #
# Frontmatter (tolerant; no PyYAML dependency)
# --------------------------------------------------------------------------- #
def _strip_quotes(s: str) -> str:
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    return s


def parse_frontmatter(text: str) -> tuple[dict, str]:
    """Return (meta, body). Handles `key: value`, inline `[a, b]` lists, and
    block `- item` lists. Good enough for our flat frontmatter contract."""
    m = FM_RE.match(text)
    if not m:
        return {}, text
    block, body = m.group(1), text[m.end():]
    meta: dict = {}
    cur_key: str | None = None
    for raw in block.split("\n"):
        if not raw.strip():
            continue
        item = re.match(r"\s*-\s+(.*)$", raw)
        if item and cur_key is not None:
            meta.setdefault(cur_key, [])
            if isinstance(meta[cur_key], list):
                meta[cur_key].append(_strip_quotes(item.group(1)))
            continue
        kv = re.match(r"([A-Za-z0-9_-]+)\s*:\s*(.*)$", raw)
        if kv:
            cur_key = kv.group(1).strip()
            val = kv.group(2).strip()
            if val == "":
                meta[cur_key] = []  # block list expected on following lines
            elif val.startswith("[") and val.endswith("]"):
                inner = val[1:-1].strip()
                meta[cur_key] = [_strip_quotes(x) for x in inner.split(",") if x.strip()]
            else:
                meta[cur_key] = _strip_quotes(val)
    return meta, body


def as_list(v) -> list[str]:
    if v is None:
        return []
    return v if isinstance(v, list) else [v]


# --------------------------------------------------------------------------- #
# Search (ripgrep with pure-python fallback)
# --------------------------------------------------------------------------- #
def _rg_invocation() -> tuple[str | None, str | None]:
    """Resolve how to run ripgrep, returning (argv0, executable).

    * (argv0, None)         -> argv0 is a real `rg` program on PATH.
    * ("rg", exec_path)     -> run `exec_path` with argv[0]="rg". This supports
                               both a real ripgrep binary at an explicit path and
                               the ripgrep that Claude Code bundles inside its own
                               executable (which behaves as rg when argv0 is "rg").
    * (None, None)          -> no ripgrep available; use the pure-python scan.

    Set $WIKI_RG to a ripgrep binary (or to the Claude exec for the bundled rg)
    to force the fast path. Otherwise a real `rg` on PATH is used if present.
    """
    forced = os.environ.get("WIKI_RG")
    if forced and os.path.exists(forced):
        return ("rg", forced)
    real = shutil.which("rg")
    if real:
        return ("rg", None)
    return (None, None)


def search_counts(root: Path, keywords: list[str], ignore_case: bool = True) -> dict[str, int]:
    """path -> total match count, for files matching ANY keyword (OR)."""
    if not keywords:
        return {}
    argv0, executable = _rg_invocation()
    if argv0:
        cmd = [argv0, "--count-matches", "--no-messages", "--no-heading", "-g", "*.md"]
        if ignore_case:
            cmd.append("-i")
        for kw in keywords:
            cmd += ["-e", kw]
        cmd.append(str(root))
        try:
            res = subprocess.run(cmd, executable=executable, capture_output=True, text=True)
            counts: dict[str, int] = {}
            for line in res.stdout.splitlines():
                path, sep, c = line.rpartition(":")
                if sep and c.isdigit():
                    counts[path] = counts.get(path, 0) + int(c)
            if counts or res.returncode in (0, 1):  # 1 = "no matches", a valid result
                return counts
        except Exception:
            pass  # fall through to pure-python
    flags = re.IGNORECASE if ignore_case else 0
    pats = [re.compile(re.escape(kw), flags) for kw in keywords]
    counts = {}
    for p in all_md_files(root):
        text = read(p)
        n = sum(len(pat.findall(text)) for pat in pats)
        if n:
            counts[str(p)] = n
    return counts


def row_for(root: Path, path: str, matches: int | None = None) -> dict:
    meta, _ = parse_frontmatter(read(path))
    rel = os.path.relpath(path, root)
    row = {
        "path": rel,
        "title": meta.get("title", rel),
        "description": meta.get("description", ""),
        "tags": as_list(meta.get("tags")),
        "type": meta.get("type", ""),
    }
    if matches is not None:
        row["matches"] = matches
    return row


# --------------------------------------------------------------------------- #
# Link graph
# --------------------------------------------------------------------------- #
def build_link_index(root: Path) -> dict[str, str]:
    """Map many keys (filename slug, relpath, title slug) -> absolute path."""
    idx: dict[str, str] = {}
    for p in all_md_files(root):
        rel = os.path.relpath(p, root)
        meta, _ = parse_frontmatter(read(p))
        keys = {
            slugify(Path(rel).stem),
            rel.lower(),
            rel[:-3].lower(),
        }
        if meta.get("title"):
            keys.add(slugify(str(meta["title"])))
        for k in keys:
            idx.setdefault(k, str(p))
    return idx


def outbound_links(root: Path, path: str, link_index: dict[str, str]) -> list[str]:
    text = read(path)
    meta, body = parse_frontmatter(text)
    out: list[str] = []
    for rel in as_list(meta.get("related")):  # frontmatter `related:` slugs are links too
        key = slugify(str(rel))
        if key in link_index:
            out.append(link_index[key])
    text = body  # don't match [[..]] inside the frontmatter block itself
    for m in WIKILINK_RE.finditer(text):
        key = slugify(m.group(1))
        if key in link_index:
            out.append(link_index[key])
    for m in MDLINK_RE.finditer(text):
        target = m.group(1).strip("<>").strip()
        if target.startswith(("http://", "https://", "#", "mailto:")):
            continue
        target = target.split("#")[0]
        if not target.endswith(".md"):
            continue
        cand = (Path(path).parent / target).resolve()
        if cand.exists():
            out.append(str(cand))
        else:
            key = slugify(Path(target).stem)
            if key in link_index:
                out.append(link_index[key])
    return list(dict.fromkeys(out))


def expand(root: Path, seeds: list[str], depth: int) -> list[str]:
    link_index = build_link_index(root)
    seen = list(dict.fromkeys(seeds))
    frontier = list(seen)
    for _ in range(max(0, depth)):
        nxt = []
        for path in frontier:
            for t in outbound_links(root, path, link_index):
                if t not in seen:
                    seen.append(t)
                    nxt.append(t)
        frontier = nxt
        if not frontier:
            break
    return seen


# --------------------------------------------------------------------------- #
# Page resolution (for inject)
# --------------------------------------------------------------------------- #
def resolve_page(root: Path, ref: str, link_index: dict[str, str]) -> str | None:
    cand = (root / ref)
    if cand.exists():
        return str(cand.resolve())
    if not ref.endswith(".md"):
        c2 = root / (ref + ".md")
        if c2.exists():
            return str(c2.resolve())
    key = slugify(Path(ref).stem)
    return link_index.get(key) or link_index.get(ref.lower())


# --------------------------------------------------------------------------- #
# Hubs: generated _index.md navigation (directory == domain)
# --------------------------------------------------------------------------- #
def hub_dirs(root: Path) -> list[Path]:
    """Directories that contain an _index.md hub."""
    return sorted({p.parent for p in root.rglob("_index.md")})


def _short_desc(desc: str, limit: int = 140) -> str:
    """A glanceable one-liner for a hub entry: first sentence, capped."""
    desc = " ".join(desc.split())
    first = desc.split(". ", 1)[0].rstrip(".")
    if len(first) <= limit:
        return first
    return first[:limit].rsplit(" ", 1)[0] + "…"


def _entry_meta(path: Path) -> tuple[str, str, str]:
    meta, _ = parse_frontmatter(read(path))
    title = str(meta.get("title") or path.stem)
    desc = _short_desc(str(meta.get("description") or ""))
    status = str(meta.get("status") or "")
    return title, desc, status


def render_shards(root: Path, hub_dir: Path) -> str:
    """Build the generated navigation block for one hub directory: its sub-hubs
    (immediate subdirs with their own _index.md) and its leaf pages."""
    lines: list[str] = [SHARDS_BEGIN, SHARDS_NOTE]

    subhubs = sorted(d for d in hub_dir.iterdir()
                     if d.is_dir() and (d / "_index.md").exists())
    leaves = sorted(p for p in hub_dir.glob("*.md") if p.name != "_index.md")

    for d in subhubs:
        title, desc, _ = _entry_meta(d / "_index.md")
        rel = f"{d.name}/_index.md"
        tail = f" — {desc}" if desc else ""
        lines.append(f"- 📁 [{title}]({rel}){tail}")
    for p in leaves:
        title, desc, status = _entry_meta(p)
        tail = f" — {desc}" if desc else ""
        flag = " _(living)_" if status == "living" else ""
        lines.append(f"- [[{p.stem}|{title}]]{tail}{flag}")

    if not subhubs and not leaves:
        lines.append("- _(no pages yet)_")
    lines.append(SHARDS_END)
    return "\n".join(lines)


def apply_shards(text: str, block: str) -> tuple[str, bool]:
    """Replace the region between the shards markers with `block`. Returns
    (new_text, had_markers)."""
    start = text.find(SHARDS_BEGIN)
    end = text.find(SHARDS_END)
    if start == -1 or end == -1 or end < start:
        return text, False
    end += len(SHARDS_END)
    return text[:start] + block + text[end:], True


def cmd_index(args) -> int:
    root = find_root(args.root)
    changed: list[str] = []
    missing_markers: list[str] = []
    for hub_dir in hub_dirs(root):
        hub = hub_dir / "_index.md"
        old = read(hub)
        block = render_shards(root, hub_dir)
        new, had = apply_shards(old, block)
        rel = os.path.relpath(hub, root)
        if not had:
            missing_markers.append(rel)
            continue
        if new != old:
            changed.append(rel)
            if not args.check:
                hub.write_text(new, encoding="utf-8")
                _READ_CACHE.pop(str(hub), None)

    for rel in missing_markers:
        print(f"WARN  {rel}: no {SHARDS_BEGIN}/{SHARDS_END} markers — skipped")
    if args.check:
        if changed:
            for rel in changed:
                print(f"STALE {rel}: generated navigation is out of date")
            print(f"\n{len(changed)} hub(s) stale — run `bin/wiki index`.")
            return 1
        print(f"OK: {len(hub_dirs(root))} hub(s) current.")
        return 0
    for rel in changed:
        print(f"wrote {rel}")
    print(f"OK: regenerated {len(changed)} hub(s); {len(hub_dirs(root))} total.")
    return 0


def hub_problems(root: Path) -> list[tuple[str, str]]:
    """Structural hub integrity: every populated directory has an _index.md, and
    every page's `type` matches its top-level domain directory."""
    problems: list[tuple[str, str]] = []
    for p in all_md_files(root):
        rel = os.path.relpath(p, root)
        parts = Path(rel).parts
        # 1. type == top-level domain directory (hubs are navigation, not domain
        #    entities, so _index.md is exempt; the root hub is too)
        if len(parts) > 1 and p.name != "_index.md":
            domain = parts[0]
            meta, _ = parse_frontmatter(read(p))
            t = meta.get("type")
            expected = DOMAIN_TYPE.get(domain, domain.rstrip("s"))
            if t and t != expected and domain in DOMAIN_TYPE:
                problems.append((rel, f"type {t!r} != domain {domain!r} (expected {expected!r})"))
    # 2. every directory with a non-_index leaf must have an _index.md hub
    for d in sorted({(root / Path(os.path.relpath(p, root)).parent)
                     for p in all_md_files(root)}):
        leaves = [p for p in d.glob("*.md") if p.name != "_index.md"]
        if leaves and not (d / "_index.md").exists():
            problems.append((os.path.relpath(d, root), "directory has pages but no _index.md hub"))
    return problems


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #
def cmd_search(args) -> int:
    root = find_root(args.root)
    counts = search_counts(root, args.keywords)
    rows = [row_for(root, p, c) for p, c in counts.items()]

    if args.tag:
        wanted = {t.lower() for t in args.tag}
        rows = [r for r in rows if wanted & {t.lower() for t in r["tags"]}]
    if args.type:
        rows = [r for r in rows if r["type"] == args.type]
    rows.sort(key=lambda r: (-r.get("matches", 0), r["path"]))

    if args.json:
        print(json.dumps(rows, indent=2))
        return 0

    if not rows:
        print(f"no matches for {args.keywords or '(none)'} in {root}")
        return 0

    groups: dict[str, list[dict]] = {}
    for r in rows:
        top = r["path"].split("/")[0] if "/" in r["path"] else "."
        groups.setdefault(top, []).append(r)

    print(f"{len(rows)} match(es) in {root}\n")
    for top in sorted(groups):
        print(f"{top}/  ({len(groups[top])})")
        for r in groups[top]:
            tags = f"  [{','.join(r['tags'])}]" if r["tags"] else ""
            desc = f"  — {r['description']}" if r["description"] else ""
            print(f"  {r['path']:<34} ({r['matches']}){desc}{tags}")
        print()
    kw = " ".join(args.keywords)
    print(f"→ inject: bin/wiki inject {kw} --depth 1")
    return 0


def cmd_inject(args) -> int:
    root = find_root(args.root)
    link_index = build_link_index(root)
    seeds: list[str] = []
    if args.all:
        seeds += [str(p) for p in all_md_files(root)]
    for ref in (args.page or []):
        r = resolve_page(root, ref, link_index)
        if r:
            seeds.append(r)
        else:
            print(f"[warn] page not found: {ref}", file=sys.stderr)
    if args.keywords:
        seeds += list(search_counts(root, args.keywords).keys())
    seeds = list(dict.fromkeys(seeds))

    if not seeds:
        print("[wiki inject] nothing to inject — pass keywords, --page, or --all", file=sys.stderr)
        return 1

    paths = expand(root, seeds, args.depth)
    total = 0
    for path in paths:
        rel = os.path.relpath(path, root)
        header = f"\n===== FILE: {rel} =====\n"
        body = read(path)
        chunk = header + body
        size = len(chunk.encode("utf-8"))
        if args.max_bytes and total + size > args.max_bytes:
            remaining = [os.path.relpath(p, root) for p in paths[paths.index(path):]]
            print(f"\n[truncated: byte budget {args.max_bytes} reached; "
                  f"{len(remaining)} page(s) omitted: {', '.join(remaining)}]")
            break
        sys.stdout.write(chunk)
        total += size
    return 0


def cmd_lint(args) -> int:
    root = find_root(args.root)
    files = [Path(args.file).resolve()] if args.file else all_md_files(root)
    problems: list[tuple[str, str]] = []
    for p in files:
        if not p.exists():
            problems.append((str(p), "file not found"))
            continue
        rel = os.path.relpath(p, root)
        meta, _ = parse_frontmatter(read(p))
        missing = [f for f in REQUIRED_FRONTMATTER if not meta.get(f)]
        if missing:
            problems.append((rel, f"missing frontmatter: {', '.join(missing)}"))
            continue
        if meta.get("type") not in VALID_TYPES:
            problems.append(
                (rel, f"invalid type {meta.get('type')!r} (valid: {', '.join(sorted(VALID_TYPES))})")
            )
        status = meta.get("status")
        if status is not None and status not in VALID_STATUS:
            problems.append(
                (rel, f"invalid status {status!r} (valid: {', '.join(sorted(VALID_STATUS))})")
            )
    # --hubs: structural integrity across the whole corpus (ignores --file)
    if getattr(args, "hubs", False) and not args.file:
        problems.extend(hub_problems(root))
    # --links: report unresolved [[wikilinks]] — INFORMATIONAL (forward-links to
    # not-yet-written pages are allowed), so it never changes the exit code
    if getattr(args, "links", False) and not args.file:
        idx = build_link_index(root)
        dangling: dict[str, str] = {}
        for p in all_md_files(root):
            _, body = parse_frontmatter(read(p))
            for m in WIKILINK_RE.finditer(body):
                slug = slugify(m.group(1))
                if slug and slug not in idx and slug not in dangling:
                    dangling[slug] = os.path.relpath(p, root)
        for slug, where in sorted(dangling.items()):
            print(f"INFO  dangling [[{slug}]] (first in {where})")
        if dangling:
            print(f"({len(dangling)} forward/dangling link(s) — allowed, not a failure)\n")
    if problems:
        for rel, msg in problems:
            print(f"FAIL  {rel}: {msg}")
        print(f"\n{len(problems)} problem(s).")
        return 1
    extra = " + hub integrity" if getattr(args, "hubs", False) else ""
    print(f"OK: {len(files)} file(s) pass frontmatter{extra} validation.")
    return 0


def cmd_links(args) -> int:
    root = find_root(args.root)
    link_index = build_link_index(root)
    target = resolve_page(root, args.page, link_index)
    if not target:
        print(f"page not found: {args.page}", file=sys.stderr)
        return 1
    rel = os.path.relpath(target, root)
    out = [os.path.relpath(p, root) for p in outbound_links(root, target, link_index)]
    inbound = []
    for p in all_md_files(root):
        if str(p) == target:
            continue
        if target in outbound_links(root, str(p), link_index):
            inbound.append(os.path.relpath(p, root))
    print(f"{rel}")
    print(f"  outbound → {', '.join(sorted(out)) or '(none)'}")
    print(f"  inbound  ← {', '.join(sorted(inbound)) or '(none)'}")
    return 0


def cmd_tags(args) -> int:
    root = find_root(args.root)
    tally: dict[str, int] = {}
    for p in all_md_files(root):
        meta, _ = parse_frontmatter(read(p))
        for t in as_list(meta.get("tags")):
            tally[t] = tally.get(t, 0) + 1
    for tag, n in sorted(tally.items(), key=lambda kv: (-kv[1], kv[0])):
        print(f"{n:>3}  {tag}")
    return 0


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="wiki", description="Fast search/inject/lint over the watchtower wiki.")
    p.add_argument("--root", help="wiki corpus root (default: ../wiki or $WATCHTOWER_WIKI)")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("search", help="OR-match keywords → lightweight index")
    s.add_argument("keywords", nargs="*")
    s.add_argument("--tag", action="append", default=[], help="filter to pages with this tag (repeatable)")
    s.add_argument("--type", help="filter to this page type")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_search)

    i = sub.add_parser("inject", help="dump full page bodies (optionally follow links)")
    i.add_argument("keywords", nargs="*")
    i.add_argument("--page", action="append", default=[], help="explicit page (path or slug); repeatable")
    i.add_argument("--depth", type=int, default=0, help="follow links BFS to this depth (default 0)")
    i.add_argument("--all", action="store_true", help="inject the entire corpus")
    i.add_argument("--max-bytes", type=int, default=0, help="byte budget; 0 = unlimited")
    i.set_defaults(func=cmd_inject)

    l = sub.add_parser("lint", help="validate frontmatter (and hub integrity with --hubs)")
    l.add_argument("--file", help="lint a single file instead of the whole corpus")
    l.add_argument("--hubs", action="store_true",
                   help="also check hub integrity: every populated dir has _index.md, type matches domain")
    l.add_argument("--links", action="store_true",
                   help="also report unresolved [[wikilinks]] (informational — forward-links are allowed)")
    l.set_defaults(func=cmd_lint)

    ix = sub.add_parser("index", help="regenerate each _index.md hub's navigation from leaf frontmatter")
    ix.add_argument("--check", action="store_true", help="report stale hubs without writing (CI gate)")
    ix.set_defaults(func=cmd_index)

    lk = sub.add_parser("links", help="show inbound/outbound links for a page")
    lk.add_argument("page")
    lk.set_defaults(func=cmd_links)

    t = sub.add_parser("tags", help="list tags with counts")
    t.set_defaults(func=cmd_tags)
    return p


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
