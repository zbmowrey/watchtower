#!/usr/bin/env bash
# watchtower guard suite — the mechanical anti-rot for the wiki. Run by the
# .githooks/pre-commit hook. HARD checks fail the commit; SOFT checks only report.
#
#   HARD  wiki frontmatter · wiki hub integrity · hubs current
#   SOFT  dangling [[wikilinks]] (forward-links are allowed while a page is a stub)
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
rc=0
hard() { echo "── $1"; shift; "$@" || { rc=1; echo "   ✗ FAILED"; }; }
soft() { echo "── $1 (advisory)"; shift; "$@" || true; }

echo "watchtower guards"
hard "wiki frontmatter"   bin/wiki lint
hard "wiki hub integrity" bin/wiki lint --hubs
hard "wiki hubs current"  bin/wiki index --check
soft "dangling wikilinks" bin/wiki lint --links

echo ""
if [ "$rc" -eq 0 ]; then echo "✓ all hard guards green"; else echo "✗ hard guard(s) red — fix before committing"; fi
exit $rc
