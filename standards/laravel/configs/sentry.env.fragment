# ── Error tracking (Sentry SaaS — fleet standard) ───────────────────────────
# Rule of record: fleet-app-specification §5. Package: sentry/sentry-laravel
# (runtime require — see composer.fragment.json). Wire in bootstrap/app.php's
# ->withExceptions(...) closure: \Sentry\Laravel\Integration::handles($exceptions);
#
# LOCAL DEV (this .env.example default): OFF. An empty DSN makes the SDK inert —
# leave SENTRY_LARAVEL_DSN unset locally so dev never reports to SaaS.
SENTRY_LARAVEL_DSN=
# Conservative sampling — this is SaaS billing. Performance traces sampled low;
# profiling off unless an app has a measured need.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Environment tag defaults to APP_ENV; uncomment to override.
# SENTRY_ENVIRONMENT=production
#
# Release tag: left unset locally (dev has no meaningful release). In prod it is
# the deployed git SHA, so an error can be pinned to the deploy that introduced
# it — see the PROD note below for where it actually comes from.
#
# PROD (set in the app's k8s infra/<app>/values.yaml ConfigMap/Secret, NOT here):
#   SENTRY_LARAVEL_DSN=<the project DSN>   # a Secret, never committed
#   SENTRY_TRACES_SAMPLE_RATE=0.1
#   SENTRY_PROFILES_SAMPLE_RATE=0.0
#   SENTRY_RELEASE                         # NOT a values.yaml `config:` entry —
#     the chart derives it in templates/configmap.yaml as
#       SENTRY_RELEASE: {{ .Values.image.tag | quote }}
#     because image.tag already IS the deployed SHA and the deploy workflow seds
#     exactly that one field. Setting it under `config:` too would emit a
#     duplicate ConfigMap key. Rule of record: fleet-app-specification §5.
