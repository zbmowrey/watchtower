# ── Default-user seeding — the three identity planes (fleet standard) ────────
# Rule of record: fleet-app-specification §5 (Identity planes & default-user
# seeding). Bundle config: configs/seeding.php. Seeders:
# database/seeders/{AdministratorSeeder,OperatorSeeder,DefaultAppUserSeeder}.php.
#
# One key pair per plane. Each seeder is idempotent (updateOrCreate on email → a
# re-run converges the account to these values) and INERT when its pair is blank
# (an unset plane seeds nothing — no phantom account). Read only through
# config/seeding.php, never env() inside a seeder (config:cache-safe).
#
# LOCAL (the .env.example defaults below): ship a known password so every
# developer seeds identical credentials.
#
# PROD (set in the app's k8s infra/<app>/values.yaml from a Secret, NOT here):
# inject a long random *_DEFAULT_PASSWORD — rotating the Secret + re-seeding
# rotates the login. Leave a plane's keys unset to seed no default user for it.

# Administrators — the control plane (administrators table / `admin` guard, /control).
# The provider's (DP) platform staff. MANDATORY on every app.
CONTROL_DEFAULT_NAME="Control Admin"
CONTROL_DEFAULT_USERNAME=your-org@gmail.com
CONTROL_DEFAULT_PASSWORD=password

# Operators — the app-admin plane (operators table / `operator` guard, /admin).
# The client's app staff. Only where a distinct external client operates the app.
OPERATOR_DEFAULT_NAME="Business Operator"
OPERATOR_DEFAULT_USERNAME=your-org@gmail.com
OPERATOR_DEFAULT_PASSWORD=password

# Application user (users table / default `web` guard). Consumers.
APP_DEFAULT_NAME="Owner"
APP_DEFAULT_USERNAME=your-org@gmail.com
APP_DEFAULT_PASSWORD=password

# Tenant plane — MULTI-TENANT APPS ONLY (per-tenant database).
# Seeded into EVERY tenant, so blank means no operator is created at all.
# Multi-tenant apps should also gate the call on `local`: real tenants get their
# owner provisioned by the tenant-creation action, not by a seeder.
TENANT_DEFAULT_NAME="Operator"
TENANT_DEFAULT_USERNAME=operator@example.com
TENANT_DEFAULT_PASSWORD=password
