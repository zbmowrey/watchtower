includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/pestphp/pest/extension.neon
    - vendor/pestphp/pest/phpstan-pest-extension.neon

parameters:
    # Analyse production code and the structural/unit suites. Config, routes and
    # migrations are declarative framework idiom — we don't strict-rule
    # them. Feature/Integration tests boot the framework and aren't analysed.
    paths:
        - app/
        - database/seeders/
        - tests/Unit/
        - tests/Architecture/

    # Floor 8, target 10 (spec §2, 2026-08-08 — PHPStan 2.x ceiling is 10, and
    # levels 9/10 machine-check the validate-at-the-boundary doctrine). Existing
    # apps ratchet 8 → 9 → 10 clean-or-frozen-baseline; NEW APPS SET THIS TO 10.
    level: 8

    # phpstan-strict-rules on, minus the one Laravel-hostile rule:
    # dynamicCallOnStaticMethod flags Eloquent's Model::query() / facade static
    # API — idiomatic Laravel that Larastan already models correctly.
    strictRules:
        dynamicCallOnStaticMethod: false

    # Treat readonly property writes outside the constructor as errors.
    checkModelProperties: true

    # Enforces the php-language-doctrine #[\Override] mandate — a renamed parent
    # method breaks the build instead of silently orphaning its overrides.
    checkMissingOverrideMethodAttribute: true

    parallel:
        maximumNumberOfProcesses: 4

    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # arch() chains (->preset(), ->expect(), ->toBeUsed(), ...) are a Pest DSL
        # the phpstan-pest extension represents as TestCall; the fluent arch
        # methods aren't on that stub. Scoped strictly to the architecture suite.
        -
            message: '#^Call to an undefined method Pest\\PendingCalls\\TestCall::.*\(\)\.$#'
            path: tests/Architecture/*
