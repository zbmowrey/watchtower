# ── Logging (fleet standard) ────────────────────────────────────────────────
# Rule of record: fleet-app-specification §5. Rationale: logging-monitoring-ir
# (#production-logging-standard). Bundle config: configs/logging.php.
#
# PROD (set in the app's k8s infra/<app>/values.yaml ConfigMap, NOT here):
#   LOG_CHANNEL=stack
#   LOG_STACK=stderr
#   LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter   # structured JSON → Loki
#   LOG_LEVEL=info
# File drivers (single/daily) are FORBIDDEN in prod: the hardened pods run
# readOnlyRootFilesystem, so storage/logs is not writable and file logs are
# silently dropped (a documented tradeoff). stderr → Alloy → Loki.
#
# PROD error-notification leg (fleet-app-specification §5): LOG_STACK=stderr,discord
# with LOG_DISCORD_WEBHOOK_URL from the app's k8s Secret — the #alerts
# channel webhook URL **including the /slack suffix** (Discord's Slack-compat
# endpoint). Level floor LOG_DISCORD_LEVEL defaults to `error`. Unset locally =
# channel inert. Storm control stays with Grafana app-error-spike (fleet-alerting).
#
# LOCAL DEV (the .env.example defaults below): file logs are fine and expected.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DISCORD_WEBHOOK_URL=
LOG_DISCORD_LEVEL=error
