# Fleet husky pre-push — HEAVY gate: full static analysis + the whole Pest suite.
# Bypass in an emergency: git push --no-verify
#
# Execution model (FLEET STANDARD): the whole toolchain runs INSIDE the dedicated
# `vite` compose service (app image = PHP + node, shared Linux node_modules, DB
# reach) — nothing runs on the host. `vite` must be running; the hook fails fast if
# it isn't. See .husky/pre-commit for the rationale.

VITE="./vendor/bin/sail exec -T -u sail vite"

if [ -z "$(./vendor/bin/sail ps --status running -q vite 2>/dev/null)" ]; then
    echo "✖ pre-push: the vite container isn't running."
    echo "  Start the stack first:  ./vendor/bin/sail up -d   (or: just start <app>)"
    exit 1
fi

$VITE composer stan

# Browser/Playwright apps exclude the Browser suite here (no Chromium in the
# image): `$VITE ./vendor/bin/pest --testsuite=Unit,Feature,Architecture`.
$VITE ./vendor/bin/pest
